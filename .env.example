# ==============================================================================
# CyberHaxs Website - Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development.
# In Render, configure these variables in the Render Dashboard Environment settings.
#
# NOTE: All variables prefixed with VITE_ are embedded into the client bundle
# at build time. NEVER store secrets, private keys, or passwords here.
# ==============================================================================

# Base Site URL (without trailing slash)
# Local:       http://localhost:5173
# Production:  Configure in Render Dashboard with actual deployed domain
VITE_SITE_URL=

# Primary Business Contact Email
VITE_CONTACT_EMAIL=info@cyberhaxs.com

# Contact Form API Endpoint (e.g. Formspree, Web3Forms, or custom API)
# Leave empty if no backend is attached (contact form surfaces honest unconfigured status)
VITE_CONTACT_ENDPOINT=
